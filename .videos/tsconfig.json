{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "types": [
      "node",
      "react"
    ]
  },
  "exclude": [
    "remotion.config.ts",
    "node_modules",
    ".cache",
    "temp",
    "history",
    "assets",
    "public"
  ]
}
